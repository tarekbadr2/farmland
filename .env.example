# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# "demo" (default, zero-config) or "firebase"
NEXT_PUBLIC_DATA_SOURCE=demo

# Which farm document the app reads. One project can host many farms.
NEXT_PUBLIC_FARM_ID=farm_nile_delta

# ---------------------------------------------------------------------------
# Firebase web config — required when NEXT_PUBLIC_DATA_SOURCE=firebase
#
# Firebase console → Project settings → General → Your apps → Web app → Config.
# These values are public by design: they ship to the browser and identify the
# project, they do not authorise anything. Access control lives in
# firestore.rules. Treat them as configuration, not secrets.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Seed script only (server-side, never bundled)
#
# Path to a service-account JSON: Firebase console → Project settings →
# Service accounts → Generate new private key. THIS ONE IS A REAL SECRET —
# it bypasses all security rules. Keep it outside the repo.
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
SEED_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Production admin credentials (hosts with no filesystem, e.g. Vercel)
#
# The same service-account JSON as above, but pasted as a single-line string
# instead of a file path. The API route uses this when present, else falls back
# to GOOGLE_APPLICATION_CREDENTIALS for local dev. REAL SECRET — set it only in
# the host's encrypted env settings, never commit it. Only needed for the AI
# advisor's auth gate; the app runs fine without it.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# AI advisor (server-side only, never bundled)
#
# Powers the real-LLM answers on the Assistant page. THIS IS A SECRET — it is
# read only in the /api/assistant route and must NOT be prefixed NEXT_PUBLIC_.
# Get one at console.anthropic.com. Without it the assistant automatically
# falls back to the built-in rule-based advisor.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Billing — Paymob (server-side only, never bundled)
#
# Subscriptions are charged through Paymob's Accept API. Until all four values
# are set, checkout stays in "coming soon" mode and nothing is charged. These
# are REAL SECRETS — set them only in the host's encrypted env (Vercel → Project
# → Settings → Environment Variables), never prefix with NEXT_PUBLIC_, never
# commit. From the Paymob dashboard:
#   PAYMOB_API_KEY        — Settings → Account Info → API Key
#   PAYMOB_INTEGRATION_ID — Developers → Payment Integrations → your card
#                           integration's ID (a number)
#   PAYMOB_IFRAME_ID      — Developers → iFrames → your iFrame's ID (a number)
#   PAYMOB_HMAC_SECRET    — Settings → Account Info → HMAC (verifies webhooks)
# Then point Paymob's "Transaction processed callback" at
#   https://<your-domain>/api/billing/webhook
# ---------------------------------------------------------------------------
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Turn the paywall ON. Leave unset (or 0) while testing so the trial/paywall are
# visible but never block access; set to 1 once Paymob is live and prices final.
NEXT_PUBLIC_BILLING_ENFORCED=

# ---------------------------------------------------------------------------
# Error tracking (Sentry) — public by design (client-side DSN)
#
# Captures browser crashes + unhandled rejections. Safe to leave blank: without
# it, error tracking is a no-op (errors just log to the console). Create a
# project at sentry.io → Settings → Client Keys (DSN).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Transactional email — Resend (server-side only, never bundled)
#
# Powers welcome, trial-ending and payment-receipt emails. Set BOTH values on
# Vercel (for the payment-receipt webhook) AND on the Cloud Functions (welcome +
# trial-ending reminders). No-op until set. EMAIL_FROM must be on a domain you've
# verified in Resend, e.g. "Herd OS <noreply@your-domain>". Key from resend.com.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# Optional integrations
NEXT_PUBLIC_WEATHER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
