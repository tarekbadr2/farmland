{
  "name": "herd-os-desktop",
  "productName": "Herd OS",
  "version": "0.2.0",
  "description": "Herd OS — Buffalo Farm Management (desktop shell)",
  "author": "Tarek Badr",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "farm.herdos.desktop",
    "productName": "Herd OS",
    "directories": {
      "output": "dist"
    },
    "artifactName": "Herd-OS-Setup.exe",
    "files": [
      "main.js",
      "app-icon.png"
    ],
    "extraResources": [
      { "from": "../out", "to": "app", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Herd OS"
    }
  },
  "dependencies": {
    "serve-handler": "^6.1.7"
  }
}
