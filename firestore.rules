rules_version = '2';

// ---------------------------------------------------------------------------
// Herd OS security rules
//
// Model: every document lives under farms/{farmId}/…, so authorisation is a
// single membership lookup rather than a predicate on each document. Access is
// PERMISSION-first: each gate checks a `module.action` key held on the member
// document (farms/{farmId}/members/{uid}.permissions) — the same set the UI
// reads, so interface and database can never disagree. Roles are just named
// bundles of these keys (see src/core/auth/permissions.ts).
//
// Legacy member docs (written before this system) carry a role and an empty
// permissions array; legacyPerms() maps those five old roles to keys so they
// keep working without a migration. New members always carry explicit keys.
//
// The UI is not the enforcement point. Everything below must hold even if
// someone drives the SDK directly from a console.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function member(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }

    function isMember(farmId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }

    function role(farmId) {
      return member(farmId).data.role;
    }

    function hasRole(farmId, roles) {
      return isMember(farmId) && role(farmId) in roles;
    }

    function isOwner(farmId) {
      return hasRole(farmId, ['owner']);
    }

    // ------------------------- Permission model ---------------------------
    // Map the five legacy roles to permission keys (module wildcards keep it
    // compact). Only these old roles ever have an empty permissions array; every
    // role introduced with the RBAC system writes explicit keys.
    function legacyPerms(r) {
      return r == 'owner' ? ['*']
        : (r == 'manager' ? ['animals.*','medical.*','vaccinations.*','breeding.*','milk.*','feeding.*','inventory.*','maintenance.*','tasks.*','expenses.*','accounting.*','payroll.read','employees.read','employees.manage','reports.read','org.members','org.settings']
        : (r == 'veterinarian' ? ['animals.read','medical.*','vaccinations.*','breeding.*','tasks.read','reports.read']
        : (r == 'accountant' ? ['expenses.*','accounting.*','payroll.read','employees.read','reports.read']
        : (r == 'worker' ? ['animals.read','milk.read','feeding.*','tasks.*']
        : []))));
    }

    // The effective permission set: explicit keys if present, else derived from
    // the (legacy) role.
    function permsOf(farmId) {
      return member(farmId).data.get('permissions', []).size() > 0
        ? member(farmId).data.permissions
        : legacyPerms(member(farmId).data.get('role', ''));
    }

    // Does the member hold this permission? `key` is the exact key, `wild` its
    // module wildcard (e.g. 'animals.write' + 'animals.*'). `*` always wins.
    function hasPerm(farmId, key, wild) {
      return isMember(farmId) && permsOf(farmId).hasAny(['*', key, wild]);
    }

    // The org a user belongs to (top-level mapping written server-side).
    function myOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', '');
    }

    // ------------------------- Organizations ------------------------------
    // Lightweight grouping over farms. A user can read their own org; only the
    // org owner edits it. Invites are managed exclusively by admin Cloud
    // Functions (secure tokens), so they're closed to direct client access.
    match /orgs/{orgId} {
      allow read: if signedIn() && myOrg() == orgId;
      allow write: if false; // provisioned/edited server-side (createFarm, admin)

      match /invites/{token} {
        allow read, write: if false; // createInvite / getInvite / acceptInvite (admin)
      }
    }

    // ----------------------------- Farm root ------------------------------
    match /farms/{farmId} {
      allow read: if isMember(farmId);
      // Farm settings are an admin action (org.settings). Billing state is
      // server-only: `subscription` and `aiUsage` can never be changed by a
      // client — the Cloud Functions / API routes write those with admin
      // credentials, which bypass these rules.
      allow update: if hasPerm(farmId, 'org.settings', 'org.*')
        && request.resource.data.subscription == resource.data.subscription
        && request.resource.data.aiUsage == resource.data.aiUsage;
      allow create, delete: if false;   // provisioned server-side only

      // ------------------------- Membership --------------------------
      // A member may read the roster (the UI shows who's on shift), or confirm
      // their own record so a non-member's login resolves to "no access". Only
      // holders of org.members (owner/admin) change membership — nobody
      // self-promotes; the members function does invite promotion with admin
      // rights.
      match /members/{uid} {
        allow read: if isMember(farmId) || request.auth.uid == uid;
        allow write: if hasPerm(farmId, 'org.members', 'org.*');
      }

      // Legacy per-farm invites (email-keyed). New invites live at org level and
      // are function-managed; this stays for backward compatibility.
      match /pendingMembers/{email} {
        allow read, write: if hasPerm(farmId, 'org.members', 'org.*');
      }

      // --------------------------- Herd ------------------------------
      match /animals/{animalId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'animals.write', 'animals.*');
        allow delete: if hasPerm(farmId, 'animals.delete', 'animals.*');

        match /weights/{weightId} {
          allow read: if isMember(farmId);
          allow write: if isMember(farmId);   // smart scale writes as the handler
        }
      }

      match /zones/{zoneId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'animals.write', 'animals.*');
      }

      // --------------------------- Milk ------------------------------
      // Milkers write; nobody edits history. A record older than 2 days is
      // frozen so yesterday's numbers can't drift after the tanker's been paid.
      match /milkRecords/{recordId} {
        allow read: if isMember(farmId);
        allow create: if hasPerm(farmId, 'milk.write', 'milk.*')
                      && request.resource.data.volumeL is number
                      && request.resource.data.volumeL >= 0
                      && request.resource.data.volumeL < 80;
        allow update: if hasPerm(farmId, 'org.settings', 'org.*')
                      || (hasPerm(farmId, 'milk.write', 'milk.*')
                          && resource.data.recordedAt is timestamp
                          && request.time < resource.data.recordedAt + duration.value(2, 'd'));
        allow delete: if hasPerm(farmId, 'org.settings', 'org.*');
      }

      match /milkDaily/{date} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'milk.write', 'milk.*');
      }

      // ------------------------ Clinical -----------------------------
      match /health/{eventId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'medical.write', 'medical.*');
        allow delete: if isOwner(farmId);
      }

      match /breeding/{eventId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'breeding.write', 'breeding.*');
        allow delete: if isOwner(farmId);
      }

      match /semen/{strawId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'breeding.write', 'breeding.*');
      }

      // --------------------- Feed & inventory ------------------------
      match /feedItems/{itemId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'feeding.write', 'feeding.*');
      }
      match /rations/{rationId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'feeding.write', 'feeding.*');
      }
      match /feedConsumption/{recordId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'feeding.write', 'feeding.*');
      }
      match /inventory/{itemId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'inventory.write', 'inventory.*');
      }
      // Document-number sequences. Anyone who can create a numbered document may
      // advance its counter; the transaction that does it is the integrity point.
      match /docCounters/{series} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*')
                      || hasPerm(farmId, 'expenses.write', 'expenses.*')
                      || hasPerm(farmId, 'inventory.write', 'inventory.*');
      }
      // Branches and rates shape every report, so only the people who own the
      // numbers may change them.
      match /branches/{branchId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
      }
      match /currencies/{currencyId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
      }
      match /workOrders/{orderId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'maintenance.write', 'maintenance.*');
        allow delete: if false;
      }
      // A pen move is a record of what happened, so it isn't edited away.
      match /livestockTransfers/{transferId} {
        allow read: if isMember(farmId);
        allow create: if hasPerm(farmId, 'animals.write', 'animals.*');
        allow update, delete: if false;
      }
      // Transfer requests (طلب تحويل): any member may raise one; approving or
      // rejecting (an update) needs animals.write — approval also writes the
      // real, immutable livestockTransfer, which the same permission guards.
      match /transferRequests/{requestId} {
        allow read: if isMember(farmId);
        allow create: if isMember(farmId);
        allow update: if hasPerm(farmId, 'animals.write', 'animals.*');
        allow delete: if false;
      }
      match /warehouses/{warehouseId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'inventory.write', 'inventory.*');
      }
      match /stockMovements/{movementId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'inventory.write', 'inventory.*');
      }
      // Itemised purchase log — an immutable record of what was bought and for
      // how much; drives the Purchases screen's spend analytics.
      match /purchases/{purchaseId} {
        allow read: if hasPerm(farmId, 'inventory.read', 'inventory.*');
        allow create: if hasPerm(farmId, 'inventory.write', 'inventory.*');
        allow update, delete: if false;
      }

      // ---------------------------- People ---------------------------
      // Salaries are in here. Reading needs an HR/payroll/accounting grant;
      // managing (write) needs employees.manage.
      match /employees/{employeeId} {
        allow read: if hasPerm(farmId, 'employees.read', 'employees.*')
                    || hasPerm(farmId, 'payroll.read', 'payroll.*')
                    || hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'employees.manage', 'employees.*');
      }

      match /attendance/{recordId} {
        allow read: if hasPerm(farmId, 'employees.read', 'employees.*')
                    || hasPerm(farmId, 'payroll.read', 'payroll.*')
                    || hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow create: if isMember(farmId);
        allow update, delete: if hasPerm(farmId, 'employees.manage', 'employees.*');
      }

      match /tasks/{taskId} {
        allow read: if isMember(farmId);
        allow create, delete: if hasPerm(farmId, 'tasks.write', 'tasks.*');
        // A worker may only move a task assigned to them, and only its status.
        allow update: if hasPerm(farmId, 'tasks.write', 'tasks.*')
                      || (isMember(farmId)
                          && resource.data.assigneeId == member(farmId).data.get('employeeId', '')
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly(['status', 'completedAt', 'notes']));
      }

      // --------------------------- Money -----------------------------
      match /transactions/{txnId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*')
                    || hasPerm(farmId, 'expenses.read', 'expenses.*')
                    || hasPerm(farmId, 'payroll.read', 'payroll.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*')
                    || hasPerm(farmId, 'expenses.write', 'expenses.*');
      }
      match /invoices/{invoiceId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*')
                    || hasPerm(farmId, 'expenses.read', 'expenses.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
      }
      match /partners/{partnerId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
      }

      match /assets/{assetId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
      }

      // The books. Reading needs accounting.read (sealed at the DB, not just
      // hidden in the UI — a farm hand can't pull the ledger by going around the
      // app); only the people who own the numbers may write. Deleting a posted
      // entry is never allowed — the ledger is corrected with a reversing entry,
      // so the audit trail stands.
      match /cheques/{chequeId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
        allow delete: if false;
      }
      match /accounts/{accountId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
      }
      match /journalEntries/{entryId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow create, update: if hasPerm(farmId, 'accounting.write', 'accounting.*');
        allow delete: if false;
      }
      match /fiscalYears/{yearId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*');
        allow delete: if false;
      }

      // ------------------------- Telemetry ---------------------------
      match /alerts/{alertId} {
        allow read: if isMember(farmId);
        allow update: if isMember(farmId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['read']);
        allow create, delete: if hasPerm(farmId, 'org.settings', 'org.*');
      }
      match /telemetry/{docId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'org.settings', 'org.*');
      }
      match /utilities/{readingId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*')
                    || hasPerm(farmId, 'org.settings', 'org.*');
      }

      // Activity log — append-only. Any member may write an entry for an action
      // they performed; reading the trail needs audit.read; nobody edits or
      // deletes history.
      match /auditLog/{entryId} {
        allow read: if hasPerm(farmId, 'audit.read', 'audit.*');
        allow create: if isMember(farmId);
        allow update, delete: if false;
      }
    }

    // Which org/farms a user belongs to. The app reads its own mapping at login
    // to resolve the active farm; it's written server-side only (createFarm,
    // invite acceptance, admin), so a user can't reassign themselves.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public demo-request leads from the marketing site. Anyone may submit one
    // (validated), but nobody can read or change them from the client.
    match /leads/{leadId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.get('message', '').size() < 2000;
      allow read, update, delete: if false;
    }

    // Anything not matched above is denied. Keep it that way.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
