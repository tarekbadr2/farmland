{
  "name": "buffalo-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "postbuild": "node scripts/precache-manifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run firestore-rules\"",
    "seed": "tsx scripts/seed-firestore.mjs",
    "seed:dry": "tsx scripts/seed-firestore.mjs --dry-run",
    "seed:reset": "tsx scripts/seed-firestore.mjs --wipe",
    "verify": "node scripts/verify-firestore.mjs",
    "grant": "node scripts/grant-role.mjs",
    "members": "node scripts/grant-role.mjs --list",
    "emulators": "firebase emulators:start",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage \"vitest run storage-rules\""
  },
  "dependencies": {
