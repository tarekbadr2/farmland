# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# desktop static-export build helpers
/.api-stash/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
*.serviceaccount.json
serviceAccount*.json

# generated at build time by scripts/precache-manifest.mjs (postbuild)
/public/precache.js

# Cloud Functions build output (regenerated by the predeploy build step)
functions/lib/

# Desktop (Electron) shell build artifacts
desktop/node_modules/
desktop/dist/

# .env.example is the template and is safe to commit
!.env.example
