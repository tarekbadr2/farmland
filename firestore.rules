rules_version = '2';

// ---------------------------------------------------------------------------
// Herd OS security rules
//
// Model: every document lives under farms/{farmId}/…, so authorisation is a
// single membership lookup rather than a predicate on each document. Access is
// PERMISSION-first: each gate checks a `module.action` key held on the member
// document (farms/{farmId}/members/{uid}.permissions) — the same set the UI
// reads, so interface and database can never disagree. Roles are just named
// bundles of these keys (see src/core/auth/permissions.ts).
//
// Legacy member docs (written before this system) carry a role and an empty
// permissions array; legacyPerms() maps those five old roles to keys so they
// keep working without a migration. New members always carry explicit keys.
//
// The UI is not the enforcement point. Everything below must hold even if
// someone drives the SDK directly from a console.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function member(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }

    function isMember(farmId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }

    function role(farmId) {
      return member(farmId).data.role;
    }

    function hasRole(farmId, roles) {
      return isMember(farmId) && role(farmId) in roles;
    }

    function isOwner(farmId) {
      return hasRole(farmId, ['owner']);
    }

    // ------------------------- Permission model ---------------------------
    // Map the five legacy roles to permission keys (module wildcards keep it
    // compact). Only these old roles ever have an empty permissions array; every
    // role introduced with the RBAC system writes explicit keys.
    function legacyPerms(r) {
      return r == 'owner' ? ['*']
        : (r == 'manager' ? ['animals.*','medical.*','vaccinations.*','breeding.*','milk.*','feeding.*','inventory.*','maintenance.*','tasks.*','expenses.*','accounting.*','payroll.read','employees.read','employees.manage','reports.read','org.members','org.settings']
        : (r == 'veterinarian' ? ['animals.read','medical.*','vaccinations.*','breeding.*','tasks.read','reports.read']
        : (r == 'accountant' ? ['expenses.*','accounting.*','payroll.read','employees.read','reports.read']
        : (r == 'worker' ? ['animals.read','milk.read','feeding.*','tasks.*']
        : []))));
    }

    // The effective permission set: explicit keys if present, else derived from
    // the (legacy) role.
    function permsOf(farmId) {
      return member(farmId).data.get('permissions', []).size() > 0
        ? member(farmId).data.permissions
        : legacyPerms(member(farmId).data.get('role', ''));
    }

    // Does the member hold this permission? `key` is the exact key, `wild` its
    // module wildcard (e.g. 'animals.write' + 'animals.*'). `*` always wins.
    function hasPerm(farmId, key, wild) {
      return isMember(farmId) && permsOf(farmId).hasAny(['*', key, wild]);
    }

    // A farm may WRITE only while its subscription is in good standing. The flag
    // is server-maintained — createFarm and the Paymob webhook set it, the daily
    // billingSweep keeps it honest. A missing flag reads as "active", so legacy /
    // pre-billing tenants and any unexpected shape fail OPEN (a lapsed tenant is
    // never wrongly locked out of paying; only an explicit "blocked" stops writes).
    // Reads are never gated on billing — a lapsed farm stays read-only, able to
    // view and export its own data.
    function farmActive(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId))
        .data.get('subscription', {}).get('access', 'active') != 'blocked';
    }

    // Herd cap: a create is refused once the on-farm count reaches the plan's
    // animalLimit. counts.total is maintained by the counters trigger and only
    // counts on-farm animals (disposed ones don't), so this is the plan's real
    // ceiling. The counter trails a burst of creates by the in-flight batch, so
    // this is a soft cap — it stops sustained over-provisioning, not a single
    // racing batch — which is the right trade for a rule that can't COUNT live.
    function withinHerdCap(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)).data
               .get('counts', {}).get('total', 0)
           < get(/databases/$(database)/documents/farms/$(farmId)).data
               .get('animalLimit', 1000000);
    }

    // Guards privilege grants on member docs: only an owner may hand out the
    // owner role or the '*' superperm. Everyone else (incl. org.members holders
    // like a farm_manager) can manage members but can't mint an owner.
    function grantOk(farmId) {
      return isOwner(farmId)
        || (request.resource.data.get('role', '') != 'owner'
            && !request.resource.data.get('permissions', []).hasAny(['*']));
    }

    // Prevents lateral privilege amplification: a non-owner may only grant a
    // permission set that is a subset of their OWN. Stored permission arrays are
    // concrete keys (owner is the sole '*' holder), so a token-exact subset is
    // correct — farm_manager is a superset of every assignable role, so no
    // legitimate grant is blocked, while a custom member holding org.members but
    // not, say, accounting can no longer mint a second account that does.
    function grantWithinGranter(farmId) {
      return permsOf(farmId).hasAny(['*'])
        || request.resource.data.get('permissions', []).hasOnly(permsOf(farmId));
    }

    // The org a user belongs to (top-level mapping written server-side).
    function myOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', '');
    }

    // ------------------------- Organizations ------------------------------
    // Lightweight grouping over farms. A user can read their own org; only the
    // org owner edits it. Invites are managed exclusively by admin Cloud
    // Functions (secure tokens), so they're closed to direct client access.
    match /orgs/{orgId} {
      allow read: if signedIn() && myOrg() == orgId;
      allow write: if false; // provisioned/edited server-side (createFarm, admin)

      match /invites/{token} {
        allow read, write: if false; // createInvite / getInvite / acceptInvite (admin)
      }
    }

    // ----------------------------- Farm root ------------------------------
    match /farms/{farmId} {
      allow read: if isMember(farmId);
      // Farm settings are an admin action (org.settings). Billing state is
      // server-only: `subscription` and `aiUsage` can never be changed by a
      // client — the Cloud Functions / API routes write those with admin
      // credentials, which bypass these rules.
      // NB: use get() with a default on every one of these — a farm doc that
      // predates the billing fields (or any doc simply missing one) makes a
      // bare `data.subscription` a "property is undefined" evaluation error,
      // and an erroring rule denies. That silently locked legitimate settings
      // writes out of older tenants.
      allow update: if hasPerm(farmId, 'org.settings', 'org.*')
        && request.resource.data.get('subscription', {}) == resource.data.get('subscription', {})
        && request.resource.data.get('aiUsage', {}) == resource.data.get('aiUsage', {})
        // Billing/structural fields are server-only too: a client must not be
        // able to raise its own herd cap or plan, or re-parent the farm.
        && request.resource.data.get('plan', '') == resource.data.get('plan', '')
        && request.resource.data.get('animalLimit', 0) == resource.data.get('animalLimit', 0)
        && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
        && request.resource.data.get('orgId', '') == resource.data.get('orgId', '');
      allow create, delete: if false;   // provisioned server-side only

      // ------------------------- Membership --------------------------
      // A member may read the roster (the UI shows who's on shift), or confirm
      // their own record so a non-member's login resolves to "no access". Only
      // holders of org.members (owner/admin) change membership — nobody
      // self-promotes; the members function does invite promotion with admin
      // rights.
      match /members/{uid} {
        allow read: if isMember(farmId) || request.auth.uid == uid;
        // Managing members needs org.members, but you can never mint an owner
        // unless you are one (grantOk), and you can never change your OWN role or
        // permissions (no self-promotion — the stated guarantee, now enforced).
        allow create: if hasPerm(farmId, 'org.members', 'org.*') && farmActive(farmId)
                      && grantOk(farmId) && grantWithinGranter(farmId);
        allow update: if hasPerm(farmId, 'org.members', 'org.*') && farmActive(farmId)
                      && grantOk(farmId) && grantWithinGranter(farmId)
                      && (request.auth.uid != uid
                          || (request.resource.data.get('role', '') == resource.data.get('role', '')
                              && request.resource.data.get('permissions', []) == resource.data.get('permissions', [])));
        allow delete: if hasPerm(farmId, 'org.members', 'org.*') && farmActive(farmId)
                      && request.auth.uid != uid;
      }

      // Legacy per-farm invites (email-keyed). New invites live at org level and
      // are function-managed; this stays for backward compatibility.
      match /pendingMembers/{email} {
        allow read, write: if hasPerm(farmId, 'org.members', 'org.*');
      }

      // --------------------------- Herd ------------------------------
      match /animals/{animalId} {
        allow read: if isMember(farmId);
        allow update: if hasPerm(farmId, 'animals.write', 'animals.*') && farmActive(farmId);
        // A new animal counts against the plan's herd cap (H-3).
        allow create: if hasPerm(farmId, 'animals.write', 'animals.*') && farmActive(farmId)
                      && withinHerdCap(farmId);
        // An animal is NEVER hard-deleted: milk, health, breeding and journal
        // records join on animalId, so deletion orphans history silently.
        // Leaving the herd is a disposal (sold/culled/dead), a soft transition.
        allow delete: if false;

        match /weights/{weightId} {
          allow read: if isMember(farmId);
          // Needs a herd-write permission (not just membership), and a weight is
          // a positive number within a plausible buffalo range — a scale glitch
          // or a fat-fingered value must not skew growth curves and ADG banding.
          allow create, update: if hasPerm(farmId, 'animals.write', 'animals.*') && farmActive(farmId)
                        && request.resource.data.weightKg is number
                        && request.resource.data.weightKg > 0
                        && request.resource.data.weightKg < 2000;
          allow delete: if hasPerm(farmId, 'animals.write', 'animals.*') && farmActive(farmId);
        }
      }

      match /zones/{zoneId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'animals.write', 'animals.*') && farmActive(farmId);
        // A pen deletion orphans every animal's zoneId. Retire a pen, don't
        // delete it.
        allow delete: if false;
      }

      // --------------------------- Milk ------------------------------
      // Milkers write; nobody edits history. A record older than 2 days is
      // frozen so yesterday's numbers can't drift after the tanker's been paid.
      match /milkRecords/{recordId} {
        allow read: if isMember(farmId);
        allow create: if hasPerm(farmId, 'milk.write', 'milk.*')
                      && farmActive(farmId)
                      && request.resource.data.volumeL is number
                      && request.resource.data.volumeL >= 0
                      && request.resource.data.volumeL < 80;
        allow update: if farmActive(farmId)
                      && (hasPerm(farmId, 'org.settings', 'org.*')
                          || (hasPerm(farmId, 'milk.write', 'milk.*')
                              && resource.data.recordedAt is timestamp
                              && request.time < resource.data.recordedAt + duration.value(2, 'd')));
        allow delete: if hasPerm(farmId, 'org.settings', 'org.*') && farmActive(farmId);
      }

      match /milkDaily/{date} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'milk.write', 'milk.*') && farmActive(farmId);
      }

      // ------------------------ Clinical -----------------------------
      match /health/{eventId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'medical.write', 'medical.*') && farmActive(farmId);
        allow delete: if isOwner(farmId) && farmActive(farmId);
      }

      match /breeding/{eventId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'breeding.write', 'breeding.*') && farmActive(farmId);
        allow delete: if isOwner(farmId) && farmActive(farmId);
      }

      match /semen/{strawId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'breeding.write', 'breeding.*') && farmActive(farmId);
      }

      // --------------------- Feed & inventory ------------------------
      match /feedItems/{itemId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'feeding.write', 'feeding.*') && farmActive(farmId);
      }
      match /rations/{rationId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'feeding.write', 'feeding.*') && farmActive(farmId);
      }
      match /feedConsumption/{recordId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'feeding.write', 'feeding.*') && farmActive(farmId);
      }
      match /inventory/{itemId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'inventory.write', 'inventory.*') && farmActive(farmId);
      }
      // Document-number sequences. Anyone who can create a numbered document may
      // advance its counter; the transaction that does it is the integrity point.
      match /docCounters/{series} {
        allow read: if isMember(farmId);
        allow write: if farmActive(farmId)
                      && (hasPerm(farmId, 'accounting.write', 'accounting.*')
                          || hasPerm(farmId, 'expenses.write', 'expenses.*')
                          || hasPerm(farmId, 'inventory.write', 'inventory.*'));
      }
      // Branches and rates shape every report, so only the people who own the
      // numbers may change them.
      match /branches/{branchId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
      }
      match /currencies/{currencyId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
      }
      match /workOrders/{orderId} {
        allow read: if isMember(farmId);
        allow create, update: if hasPerm(farmId, 'maintenance.write', 'maintenance.*') && farmActive(farmId);
        allow delete: if false;
      }
      // A pen move is a record of what happened, so it isn't edited away.
      match /livestockTransfers/{transferId} {
        allow read: if isMember(farmId);
        allow create: if hasPerm(farmId, 'animals.write', 'animals.*') && farmActive(farmId);
        allow update, delete: if false;
      }
      // Transfer requests (طلب تحويل): any member may raise one; approving or
      // rejecting (an update) needs animals.write — approval also writes the
      // real, immutable livestockTransfer, which the same permission guards.
      match /transferRequests/{requestId} {
        allow read: if isMember(farmId);
        allow create: if isMember(farmId) && farmActive(farmId);
        allow update: if hasPerm(farmId, 'animals.write', 'animals.*') && farmActive(farmId);
        allow delete: if false;
      }
      match /warehouses/{warehouseId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'inventory.write', 'inventory.*') && farmActive(farmId);
      }
      match /stockMovements/{movementId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'inventory.write', 'inventory.*') && farmActive(farmId);
      }
      // Itemised purchase log — an immutable record of what was bought and for
      // how much; drives the Purchases screen's spend analytics.
      match /purchases/{purchaseId} {
        allow read: if hasPerm(farmId, 'inventory.read', 'inventory.*');
        allow create: if hasPerm(farmId, 'inventory.write', 'inventory.*') && farmActive(farmId);
        allow update, delete: if false;
      }

      // ---------------------------- People ---------------------------
      // Salaries are in here. Reading needs an HR/payroll/accounting grant;
      // managing (write) needs employees.manage.
      match /employees/{employeeId} {
        allow read: if hasPerm(farmId, 'employees.read', 'employees.*')
                    || hasPerm(farmId, 'payroll.read', 'payroll.*')
                    || hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'employees.manage', 'employees.*') && farmActive(farmId);
      }

      match /attendance/{recordId} {
        allow read: if hasPerm(farmId, 'employees.read', 'employees.*')
                    || hasPerm(farmId, 'payroll.read', 'payroll.*')
                    || hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow create: if isMember(farmId) && farmActive(farmId);
        allow update, delete: if hasPerm(farmId, 'employees.manage', 'employees.*') && farmActive(farmId);
      }

      match /tasks/{taskId} {
        allow read: if isMember(farmId);
        allow create, delete: if hasPerm(farmId, 'tasks.write', 'tasks.*') && farmActive(farmId);
        // A worker may only move a task assigned to them, and only its status.
        allow update: if hasPerm(farmId, 'tasks.write', 'tasks.*')
                      || (isMember(farmId)
                          && resource.data.assigneeId == member(farmId).data.get('employeeId', '')
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly(['status', 'completedAt', 'notes']));
      }

      // --------------------------- Money -----------------------------
      match /transactions/{txnId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*')
                    || hasPerm(farmId, 'expenses.read', 'expenses.*')
                    || hasPerm(farmId, 'payroll.read', 'payroll.*');
        allow write: if farmActive(farmId)
                    && (hasPerm(farmId, 'accounting.write', 'accounting.*')
                        || hasPerm(farmId, 'expenses.write', 'expenses.*'));
      }
      match /invoices/{invoiceId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*')
                    || hasPerm(farmId, 'expenses.read', 'expenses.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
      }
      match /partners/{partnerId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
      }

      match /assets/{assetId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
      }

      // The books. Reading needs accounting.read (sealed at the DB, not just
      // hidden in the UI — a farm hand can't pull the ledger by going around the
      // app); only the people who own the numbers may write. Deleting a posted
      // entry is never allowed — the ledger is corrected with a reversing entry,
      // so the audit trail stands.
      match /cheques/{chequeId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
        allow delete: if false;
      }
      match /accounts/{accountId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
      }
      match /journalEntries/{entryId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow create, update: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
        allow delete: if false;
      }
      // Period rollups of the journal. Derived data, maintained exclusively by
      // the ledger-rollup trigger with admin credentials — a client that could
      // write these could restate the books without touching a single entry,
      // which is worse than being able to post a bad one (that at least leaves
      // an auditable document behind).
      match /ledgerRollups/{rollupId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if false;
      }
      match /fiscalYears/{yearId} {
        allow read: if hasPerm(farmId, 'accounting.read', 'accounting.*');
        allow write: if hasPerm(farmId, 'accounting.write', 'accounting.*') && farmActive(farmId);
        allow delete: if false;
      }

      // ------------------------- Telemetry ---------------------------
      match /alerts/{alertId} {
        allow read: if isMember(farmId);
        allow update: if isMember(farmId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['read']);
        allow create, delete: if hasPerm(farmId, 'org.settings', 'org.*');
      }
      match /telemetry/{docId} {
        allow read: if isMember(farmId);
        allow write: if hasPerm(farmId, 'org.settings', 'org.*');
      }
      match /utilities/{readingId} {
        allow read: if isMember(farmId);
        allow write: if farmActive(farmId)
                    && (hasPerm(farmId, 'accounting.write', 'accounting.*')
                        || hasPerm(farmId, 'org.settings', 'org.*'));
      }

      // Activity log — append-only. Any member may write an entry for an action
      // they performed; reading the trail needs audit.read; nobody edits or
      // deletes history.
      match /auditLog/{entryId} {
        allow read: if hasPerm(farmId, 'audit.read', 'audit.*');
        // Provenance is server-enforced: an entry must be attributed to the
        // caller (no forging one as the owner) and carry a server timestamp in
        // `serverAt` (no back- or future-dating to bury real history in the
        // newest-first view). Entries remain immutable once written.
        allow create: if isMember(farmId) && farmActive(farmId)
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.serverAt == request.time;
        allow update, delete: if false;
      }
    }

    // Which org/farms a user belongs to. The app reads its own mapping at login
    // to resolve the active farm; it's written server-side only (createFarm,
    // invite acceptance, admin), so a user can't reassign themselves.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public demo-request leads from the marketing site. Anyone may submit one
    // (validated), but nobody can read or change them from the client.
    match /leads/{leadId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.get('message', '').size() < 2000;
      allow read, update, delete: if false;
    }

    // Anything not matched above is denied. Keep it that way.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
